{
	"name": "Fluxo_df_cp_2",
	"properties": {
		"description": "Fluxo de dados para fazer o Join das tabelas ",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "armazena_dados",
						"type": "DatasetReference"
					},
					"name": "DBCLIENTE"
				},
				{
					"dataset": {
						"referenceName": "armazena_dados",
						"type": "DatasetReference"
					},
					"name": "DBCLIENTEFISICO"
				},
				{
					"dataset": {
						"referenceName": "armazena_dados",
						"type": "DatasetReference"
					},
					"name": "DBENDCLI"
				},
				{
					"dataset": {
						"referenceName": "armazena_dados",
						"type": "DatasetReference"
					},
					"name": "DBLOGRADOURO"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "armazena_dados",
						"type": "DatasetReference"
					},
					"name": "teste"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          NR_CLIENTE as short,",
				"          NM_CLIENTE as string,",
				"          QT_ESTRELAS as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DBCLIENTE",
				"source(output(",
				"          NR_CLIENTE as short,",
				"          FL_SEXO as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DBCLIENTEFISICO",
				"source(output(",
				"          NR_CLIENTE as short,",
				"          CD_LOGRADOURO_CLI as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DBENDCLI",
				"source(output(",
				"          CD_LOGRADOURO as integer,",
				"          NM_CIDADE as string,",
				"          NM_ESTADO as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DBLOGRADOURO",
				"DBCLIENTE, DBCLIENTEFISICO join(DBCLIENTE@NR_CLIENTE == DBCLIENTEFISICO@NR_CLIENTE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, DBENDCLI join(DBCLIENTE@NR_CLIENTE == DBENDCLI@NR_CLIENTE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, DBLOGRADOURO join(CD_LOGRADOURO_CLI == CD_LOGRADOURO,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     filePattern:'teste ',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> teste"
			]
		}
	}
}