			{
				"name": "Copiar_db_logradouro",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OracleSource",
						"oracleReaderQuery": "SELECT\n    l.cd_logradouro,\n    c.nm_cidade AS NM_CIDADE,\n    e.nm_estado as NM_ESTADO\nFROM db_logradouro L\nINNER JOIN DB_BAIRRO B ON l.cd_bairro=b.cd_bairro\nINNER JOIN DB_CIDADE C ON b.cd_cidade=c.cd_cidade\nINNER JOIN DB_ESTADO E ON c.sg_estado=e.sg_estado;",
						"partitionOption": "None",
						"numberPrecision": 38,
						"numberScale": 18,
						"queryTimeout": "02:00:00"
					},
